<VirtualHost *:80>
    ServerName {{ wordpress_domain }}
    DocumentRoot {{ wordpress_install_path }}

    Alias /.well-known/acme-challenge/ {{ wordpress_acme_webroot }}/.well-known/acme-challenge/
    <Directory {{ wordpress_acme_webroot }}/.well-known/acme-challenge/>
        Options None
        AllowOverride None
        Require all granted
    </Directory>

    <Directory {{ wordpress_install_path }}>
        Options FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    DirectoryIndex index.php index.html
    ErrorLog ${APACHE_LOG_DIR}/wordpress-error.log
    CustomLog ${APACHE_LOG_DIR}/wordpress-access.log combined
</VirtualHost>
